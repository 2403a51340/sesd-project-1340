{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/verify", "destination": "/client/verify.html" },
    { "source": "/result", "destination": "/client/result.html" },
    { "source": "/login", "destination": "/client/login.html" },
    { "source": "/register", "destination": "/client/register.html" },
    { "source": "/institution-dashboard", "destination": "/client/institution-dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/client/admin-dashboard.html" },
    { "source": "/issue-certificate", "destination": "/client/issue-certificate.html" },
    { "source": "/directory", "destination": "/client/directory.html" },
    { "source": "/certificate-details", "destination": "/client/certificate-details.html" },
    { "source": "/css/(.*)", "destination": "/client/css/$1" },
    { "source": "/js/(.*)", "destination": "/client/js/$1" },
    { "source": "/assets/(.*)", "destination": "/client/assets/$1" },
    { "source": "/", "destination": "/client/index.html" }
  ]
}
